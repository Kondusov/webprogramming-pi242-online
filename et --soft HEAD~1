[32m+[m[32m        io.emit('chat message', { username, text: msg });[m
[32m+[m[32m    });[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32m2. Системные уведомления (Кто зашел / кто вышел)[m
[32m+[m[32mПользователи должны видеть, когда в чате появляется кто-то новый.[m
[32m+[m[32m• На сервере: Рассылать уведомление в событиях подключения и отключения:javascript[m
[32m+[m[32mio.on('connection', (socket) => {[m
[32m+[m[32m    const username = socket.handshake.auth.username;[m
[32m+[m
[32m+[m[32m    // Отправляет сообщение ВСЕМ, кроме самого подключившегося (broadcast)[m
[32m+[m[32m    socket.broadcast.emit('system message', `${username} вошел в чат`);[m
