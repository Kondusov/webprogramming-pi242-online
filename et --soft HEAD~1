[32m+[m[32mДобавьте:[m
[32m+[m[32m1. Персонализация (Никнеймы и ID)[m
[32m+[m[32mСейчас все сообщения выглядят одинаково. Будет круче, если сервер будет знать, кто именно пишет.[m
[32m+[m[32m• На клиенте: Спрашивать имя при входе:javascript[m
[32m+[m[32mconst username = prompt("Введите ваше имя:") || "Аноним";[m
