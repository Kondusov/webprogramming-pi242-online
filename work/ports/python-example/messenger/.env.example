# Секреты
TOKEN_SECRET=change-me-to-a-long-random-string

# Сервер
HOST=0.0.0.0
PORT=8000

# База
DB_PATH=./data/chat.db

# Почта. Если SMTP_HOST пустой — письма печатаются в консоль (dev-режим)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@messenger.local
SMTP_TLS=true

# Ссылки
APP_URL=http://localhost:8000